<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/hbn6xkrdkm-a11y/fancy-tv-screensaver" version="1.0.0" viewmodes="fullscreen">
  <tizen:application id="ArtSaver01.Gallery" package="ArtSaver01" required_version="8.0"/>
  <tizen:profile name="tv-samsung"/>
  <content src="index.html"/>
  <icon src="assets/icon.png"/>
  <name>Fancy TV Screensaver</name>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="8.0"/>
</widget>
